{
  "name": "ledger-payment-gateway",
  "version": "1.0.0",
  "description": "High performance clean architecture payment gateway",
  "main": "dist/main.js",
  "scripts": {
    "start:api": "npx tsx --env-file=.env src/api/server.ts",
    "start:worker": "npx tsx --env-file=.env src/worker/consumer.ts",
    "build": "tsc",
    "start": "ts-node src/main.ts"
  },
  "dependencies": {
    "@opentelemetry/exporter-jaeger": "^2.12.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "express": "^4.19.2",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
